# 복사해서 omm-api.env 로 저장하고 값을 채우세요.  chmod 600 omm-api.env
# PostgreSQL (db1 · P1)  ─ API 전용 계정 omm_api (sql/omm_api_role.sql)
PGHOST=10.0.56.101
PGPORT=5432
PGDATABASE=omm
PGUSER=omm_api
PGPASSWORD=여기에_비밀번호

# 연결 풀 크기 (uvicorn 워커 1개당)
PG_POOL_MAX=5

# JWT 서명 키 ─ 아래 명령으로 만든 값을 넣으세요. 절대 공유 금지
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=여기에_긴_무작위_문자열
JWT_EXPIRE_MIN=720

# 관리자 API 를 쓸 수 있는 이메일 (쉼표로 구분). omm_users 에 역할 컬럼이 없어서 설정으로 관리
ADMIN_EMAILS=admin@omm.kr

# 프론트 개발 서버 주소 (쉼표로 구분). HAProxy 뒤에서 같은 주소로 서비스하면 비워도 됨
CORS_ORIGINS=http://localhost:5173
