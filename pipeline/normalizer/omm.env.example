# OMM 자동 실행 설정 · 이 파일을 omm.env 로 복사해서 값을 넣고:  chmod 600 omm.env
# 값은 작은따옴표로 감싸기 (특수문자 # $ 가 있어도 안전)
# 데이터 출처: own = 자체 수집(크롤링 · KAMIS · YouTube · 영양성분 API) / team = 팀 공유 데이터 zip / mongo = 팀 MongoDB 원문을 직접 정제
OMM_SOURCE='own'
# OMM_SOURCE='team' 일 때: 팀이 준 zip 파일 경로 또는 푼 폴더 (새 zip으로 바꾸면 다음 실행 때 자동으로 다시 풂)
TEAM_DATA='/opt/omm/omm_team_data_20261122.zip'
# OMM_SOURCE='mongo' 일 때: 팀 MongoDB 접속 (레플리카셋 omm-rs · 읽기만 함). 비밀번호에 @ : / 가 있으면 %40 %3A %2F 로 바꿔 쓰기
MONGO_URI='mongodb://아이디:비밀번호@몽고주소:27017/?replicaSet=omm-rs&authSource=admin'
MONGO_DB='OMM'
# 가격 집계 시작 월
PRICE_START='2025-08'
DATA_GO_KEY='공공데이터포털_Decoding_키'
YOUTUBE_KEY='YouTube_API_키'
PGHOST='10.0.56.101'
PGPORT='5432'
PGDATABASE='omm_insight'
PGUSER='omm'
PGPASSWORD='omm_계정_비밀번호'
# KAMIS 수집 시작 월 (끝 월은 자동으로 이번 달)
KAMIS_START='2024-01'
# YouTube 수집 시작 월
YT_START='2024-12'
# 메뉴로 묶을 최소 레시피 수
MIN_MENU='3'
# 크롤링: 하루 최대 몇 시간 · 분류마다 목록 몇 쪽 (20 = 약 3만 개 · 처음엔 6시간씩 약 6일 밤)
CRAWL_HOURS='6'
CRAWL_PER_VALUE='20'
